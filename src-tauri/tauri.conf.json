{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BudgetMe",
  "version": "1.2.2",
  "identifier": "com.finanzas.app",
  "build": {
    "beforeDevCommand": "npx serve src -l 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Finanzas",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:finanzas.db"]
    }
  }
}
